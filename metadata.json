{
  "name": "cirrax-postfixadmin",
  "version": "1.5.0",
  "author": "Cirrax GmbH",
  "summary": "A module to configure postfixadmin",
  "license": "GPL-3.0",
  "source": "https://github.com/cirrax/puppet-postfixadmin",
  "project_page": "https://github.com/cirrax/puppet-postfixadmin",
  "issues_url": "https://github.com/cirrax/puppet-postfixadmin/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 3.2.0 < 10.0.0"
    },
    {
      "name": "puppetlabs/concat",
      "version_requirement": ">= 2.0.0 < 10.0.0"
    },
    {
      "name": "puppetlabs/apache",
      "version_requirement": ">= 8.0.0 < 14.0.0"
    },
    {
      "name": "puppetlabs/mysql",
      "version_requirement": ">= 4.0.0 < 17.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "8",
        "9",
        "10",
        "11",
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu"
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">=8.0.0 < 9.0.0"
    }
  ],
  "tags": [
    "postfixadmin",
    "postfix",
    "mail",
    "mta",
    "email",
    "dovecot"
  ]
}
